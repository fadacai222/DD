# Default-deny Docker build context. The API image needs the Go server,
# the Admin web source compiled into /admin/, and realtime protocol fixtures used by tests.
*

!server/
!server/**
!admin/
!admin/**
!packages/
!packages/realtime_protocol/
!packages/realtime_protocol/fixtures/
!packages/realtime_protocol/fixtures/**

# Never send local credentials/configuration into BuildKit even if a future
# include rule becomes broader.
**/.env
**/.env.*
**/secrets/
**/secrets/**
**/*.pem
**/*.key
**/*firebase-adminsdk*.json

# Admin dependencies/build output are reproducible and must stay out of context.
admin/node_modules/
admin/node_modules/**
admin/dist/
admin/dist/**
admin/*.tsbuildinfo

# Local/generated Go output is not part of a reproducible server build.
server/bin/
server/bin/**
server/coverage.out
