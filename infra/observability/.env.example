# Optional observability image pins/ports. Secrets do not belong in this file.
DD_PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
DD_BLACKBOX_IMAGE=prom/blackbox-exporter:v0.27.0
DD_NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
DD_GRAFANA_IMAGE=grafana/grafana:12.1.0

DD_PROMETHEUS_PORT=19090
DD_GRAFANA_PORT=13000
DD_PROMETHEUS_RETENTION=30d

# Required: path to a host-side file containing only the Grafana admin password.
# Example Linux production path; create it outside the repository with mode 0600.
DD_GRAFANA_ADMIN_PASSWORD_FILE=/opt/dd/secrets/grafana_admin_password
DD_GRAFANA_ADMIN_USER=admin
