# DD production config for BaoTa/Nginx coexistence.
# Copy to .env and replace the domain/IP/email values.
# Secrets stay in ./secrets/*.

DD_RELEASE_VERSION=0.4.0-cloud.1
DD_IMAGE_TAG=v0.4.0-cloud.1
DD_IMAGE_REPOSITORY=local/dd-api
DD_WORKER_IMAGE_REPOSITORY=local/dd-worker
DD_MIGRATE_IMAGE_REPOSITORY=local/dd-migrate

DD_INSTANCE_NAME=DD
DD_INGRESS_MODE=bt-nginx

DD_API_DOMAIN=api.example.com
DD_LIVEKIT_DOMAIN=rtc.example.com
DD_TURN_DOMAIN=turn.example.com
DD_S3_DOMAIN=media.example.com
DD_PUBLIC_IP=203.0.113.10
DD_ACME_EMAIL=ops@example.com

# Host Nginx proxies these loopback-only backends.
DD_API_HOST_PORT=18473
DD_LIVEKIT_HOST_PORT=17880
DD_S3_HOST_PORT=19000

# DD does not bind TCP 80/443 in bt-nginx mode.
# Keep embedded TURN/UDP on 3478. TURN/TLS is disabled here because LiveKit
# browser clients expect direct TURN/TLS on public TCP 443 unless an L4 load balancer is used.
DD_TURN_UDP_PORT=3478
DD_TURN_TLS_PORT=0
DD_RTC_UDP_PORT_START=50000
DD_RTC_UDP_PORT_END=50100
DD_LIVEKIT_SKIP_EXTERNAL_IP_VALIDATION=false

# WebSocket Origin allowlist uses host[:port]. HTTP CORS uses full HTTPS origins.
DD_ALLOWED_ORIGINS=app.example.com
DD_ALLOWED_HTTP_ORIGINS=https://app.example.com

# Keep registration closed until real SMTP is configured.
DD_REGISTRATION_MODE=closed
DD_SMTP_HOST=
DD_SMTP_PORT=587
DD_SMTP_FROM=
DD_SMTP_USERNAME=

DD_POSTGRES_DB=dd
DD_POSTGRES_USER=dd
DD_MINIO_ROOT_USER=ddroot

DD_OBJECT_STORAGE_MODE=minio
DD_CADDYFILE=./Caddyfile.minio
DD_MEDIA_S3_ENDPOINT=https://media.example.com
DD_MEDIA_S3_BUCKET=dd-media
DD_MEDIA_S3_REGION=us-east-1
DD_MINIO_CORS_ORIGIN=https://app.example.com

DD_BACKUP_S3_ENDPOINT=http://minio:9000
DD_BACKUP_ROOT=./backups
DD_BACKUP_RETENTION_DAYS=14
DD_BACKUP_INTERVAL_HOURS=6
DD_RPO_HOURS=6
DD_RTO_HOURS=4

# Conservative single-host limits for roughly 4 CPU / 16 GiB RAM.
DD_API_MEMORY_LIMIT=1g
DD_API_CPU_LIMIT=1.5
DD_WORKER_MEMORY_LIMIT=1g
DD_WORKER_CPU_LIMIT=1.0
DD_POSTGRES_MEMORY_LIMIT=2g
DD_POSTGRES_CPU_LIMIT=1.5
DD_REDIS_MEMORY_LIMIT=512m
DD_REDIS_CPU_LIMIT=0.5
DD_MINIO_MEMORY_LIMIT=2g
DD_MINIO_CPU_LIMIT=1.0
DD_LIVEKIT_MEMORY_LIMIT=3g
DD_LIVEKIT_CPU_LIMIT=2.0
DD_CADDY_MEMORY_LIMIT=256m
DD_CADDY_CPU_LIMIT=0.5
DD_HAPROXY_MEMORY_LIMIT=128m
DD_HAPROXY_CPU_LIMIT=0.25
DD_LOG_MAX_SIZE=20m
DD_LOG_MAX_FILES=5

# Optional Push provider metadata. Credential files may stay empty until enabled.
DD_APNS_KEY_ID=
DD_APNS_TEAM_ID=
DD_APNS_BUNDLE_ID=
