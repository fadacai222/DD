# DD production non-secret configuration.
# Copy to .env. Secrets live in ./secrets/* and are intentionally NOT stored here.

DD_RELEASE_VERSION=dev
DD_IMAGE_TAG=dev
DD_IMAGE_REPOSITORY=local/dd-api
DD_WORKER_IMAGE_REPOSITORY=local/dd-worker
DD_MIGRATE_IMAGE_REPOSITORY=local/dd-migrate

DD_INSTANCE_NAME=DD
# caddy = built-in Caddy/HAProxy owns host 80/443; bt-nginx = existing BaoTa/Nginx keeps 80/443.
DD_INGRESS_MODE=caddy
DD_API_DOMAIN=api.example.com
DD_LIVEKIT_DOMAIN=rtc.example.com
DD_TURN_DOMAIN=turn.example.com
DD_ACME_EMAIL=ops@example.com
DD_PUBLIC_IP=203.0.113.10

# WebSocket Origin allowlist uses host[:port] entries. HTTP CORS uses full HTTPS origins.
# Comma-separated lists are supported by the server configuration parser.
DD_ALLOWED_ORIGINS=app.example.com
DD_ALLOWED_HTTP_ORIGINS=https://app.example.com

# closed is safest until SMTP and registration policy are explicitly configured.
DD_REGISTRATION_MODE=closed
DD_SMTP_HOST=
DD_SMTP_PORT=587
DD_SMTP_FROM=
DD_SMTP_USERNAME=

DD_POSTGRES_DB=dd
DD_POSTGRES_USER=dd
DD_MINIO_ROOT_USER=ddroot

# Object storage mode: minio or external-s3.
# minio: deploy.sh adds the selfhost-storage profile and Caddy publishes DD_S3_DOMAIN.
# external-s3: point DD_MEDIA_S3_ENDPOINT at the external S3-compatible HTTPS endpoint.
DD_OBJECT_STORAGE_MODE=minio
DD_S3_DOMAIN=media.example.com
DD_CADDYFILE=./Caddyfile.minio
DD_MEDIA_S3_ENDPOINT=https://media.example.com
DD_MEDIA_S3_BUCKET=dd-media
DD_MEDIA_S3_REGION=us-east-1
DD_MINIO_CORS_ORIGIN=https://app.example.com

# Optional self-hosted Whisper-compatible voice transcription provider.
# Leave both blank to disable STT. Provider credentials belong in
# ./secrets/voice_transcription_credential, never in this .env or any client.
DD_VOICE_TRANSCRIPTION_ENDPOINT=
DD_VOICE_TRANSCRIPTION_MODEL=

# Backup client endpoint. For bundled MinIO, use its internal service URL.
# For external S3, use the external S3 endpoint and provide dedicated backup credentials.
DD_BACKUP_S3_ENDPOINT=http://minio:9000
DD_BACKUP_ROOT=./backups
DD_BACKUP_RETENTION_DAYS=14
# Formal DR cadence: schedule `backup.sh --quiesce` at this interval.
# Online `backup.sh` runs are supplementary and do not establish strict cross-system RPO.
DD_BACKUP_INTERVAL_HOURS=6
DD_RPO_HOURS=6
DD_RTO_HOURS=4

# LiveKit / WebRTC. Public firewall must match these exact ports.
# Built-in caddy mode keeps TURN UDP/TLS on 443. BaoTa mode uses TURN/UDP 3478 and sets TURN/TLS to 0 (disabled).
DD_TURN_UDP_PORT=443
DD_TURN_TLS_PORT=443
DD_RTC_UDP_PORT_START=50000
DD_RTC_UDP_PORT_END=50100
# Set true only when NAT/firewall prevents LiveKit's self-ping validation but DD_PUBLIC_IP is independently verified.
DD_LIVEKIT_SKIP_EXTERNAL_IP_VALIDATION=false

# Resource ceilings. Tune after observing real traffic; these are single-host defaults.
DD_API_MEMORY_LIMIT=1g
DD_API_CPU_LIMIT=2.0
DD_WORKER_MEMORY_LIMIT=1g
DD_WORKER_CPU_LIMIT=2.0
DD_POSTGRES_MEMORY_LIMIT=2g
DD_POSTGRES_CPU_LIMIT=2.0
DD_REDIS_MEMORY_LIMIT=768m
DD_REDIS_CPU_LIMIT=1.0
DD_MINIO_MEMORY_LIMIT=2g
DD_MINIO_CPU_LIMIT=2.0
DD_LIVEKIT_MEMORY_LIMIT=4g
DD_LIVEKIT_CPU_LIMIT=4.0
DD_CADDY_MEMORY_LIMIT=512m
DD_CADDY_CPU_LIMIT=1.0
DD_HAPROXY_MEMORY_LIMIT=256m
DD_HAPROXY_CPU_LIMIT=0.5
DD_LOG_MAX_SIZE=20m
DD_LOG_MAX_FILES=5

# Optional Push provider metadata. Credentials remain secret files.
DD_APNS_KEY_ID=
DD_APNS_TEAM_ID=
DD_APNS_BUNDLE_ID=
