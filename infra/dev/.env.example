# Copy to .env with scripts/init-dev-env.ps1. Do not commit the generated .env.
DD_POSTGRES_DB=dd
DD_POSTGRES_USER=dd
DD_POSTGRES_PASSWORD=
DD_REDIS_PASSWORD=
DD_MINIO_ROOT_USER=ddadmin
DD_MINIO_ROOT_PASSWORD=
DD_LIVEKIT_API_KEY=
DD_LIVEKIT_API_SECRET=
AUTH_TOKEN_SECRET=
ADMIN_SECURITY_SECRET=
EMAIL_CODE_PEPPER=
# Optional. Leave blank to disable Telegram sticker-pack relay/import.
TELEGRAM_BOT_TOKEN=
# Optional self-hosted Whisper-compatible provider. Both endpoint and model are required together.
VOICE_TRANSCRIPTION_ENDPOINT=
VOICE_TRANSCRIPTION_MODEL=
# Server-only secret; never copy this value into Flutter/Web clients.
VOICE_TRANSCRIPTION_CREDENTIAL=
